# ---------------------------------------------------------------------------
# TurtleType environment configuration
# Copy to .env (server reads it from the repo root or from server/.env)
# ---------------------------------------------------------------------------

# --- Google OAuth (Google Cloud Console -> APIs & Services -> Credentials) ---
# Create an "OAuth client ID" of type "Web application".
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Must match an "Authorized redirect URI" on the OAuth client exactly.
GOOGLE_CALLBACK_URL=http://localhost:8080/auth/google/callback

# --- Sessions ---
# Any long random string. Generate one with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# --- Database ---
# Postgres connection string. On Railway/Render this is injected for you.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/humantype

# TLS for the database connection. Left unset, it is inferred from the host:
# private networks (postgres.railway.internal, a Compose service, localhost)
# connect without TLS; anything reachable over the public internet uses TLS
# without chain verification. Set 'true' or 'false' to override.
# DATABASE_SSL=

# --- Server ---
PORT=8080

# --- Frontend origin, used for CORS + OAuth redirects back to the app ---
CLIENT_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Stripe billing
#
# Leave every variable below unset and billing is simply off: every job runs
# for free, no ledger rows are written, and the app behaves exactly as it did
# before billing existed. That is the right setting for local development and
# for a self-hosted instance.
#
# Billing switches on only when BOTH the secret key and the webhook secret are
# present, so a half-configured deploy cannot end up charging people through a
# webhook it cannot verify.
#
# IN PRODUCTION THAT DEFAULT IS INVERTED. With NODE_ENV=production the server
# refuses to start unless it can bill: both secrets, and at least one pack
# price so a paywalled user has a way through. Free-for-everyone is a fine
# default on a laptop and a silent giveaway on the deploy that is meant to
# charge. Run `npm run launch:check -w server` to see where a deploy stands.
# ---------------------------------------------------------------------------

# Run production without billing, on purpose — self-hosting, or a staging copy
# that should not take money. Only consulted when NODE_ENV=production, where it
# is the one thing that turns the boot failure above into a warning.
# ALLOW_FREE_MODE=true

# Stripe Dashboard -> Developers -> API keys. Use the test-mode key (sk_test_...)
# until you have run a real purchase end to end.
# STRIPE_SECRET_KEY=sk_test_...

# Printed by `stripe listen --forward-to localhost:8080/api/webhooks/stripe`
# for local development; in production it comes from the endpoint you create
# under Developers -> Webhooks. These are different values — the local one only
# works with the CLI forwarder.
# STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs from Stripe -> Product catalog. Each product needs one price:
# the three packs are one-time, the plan is recurring monthly. A SKU with no
# price ID configured shows on the pricing page as unavailable rather than
# failing at checkout.
# STRIPE_PRICE_PACK_STARTER=price_...     # $9  -> 5 credits
# STRIPE_PRICE_PACK_STANDARD=price_...    # $19 -> 15 credits
# STRIPE_PRICE_PACK_BULK=price_...        # $39 -> 40 credits
# STRIPE_PRICE_PLAN_MONTHLY=price_...     # $12/mo -> 12 credits per month

# How many characters one credit buys. Changing this reprices every job, so
# change it deliberately and not on a live deploy with credits outstanding.
# CHARS_PER_CREDIT=10000

# Free credits granted once per account on first sign-in, so someone can see
# the revision history working before being asked to pay. Set to 0 to disable.
# SIGNUP_GRANT_CREDITS=1

# Ceiling on what a single job may cost. Stops one enormous document from
# consuming a whole pack and occupying a queue slot for a day.
# MAX_CREDITS_PER_JOB=20

# ---------------------------------------------------------------------------
# Who operates the service
#
# Quoted by /privacy and /terms, and checked against the Cloud project during
# Google's OAuth verification (which recurs annually). Served by the API rather
# than compiled into the SPA, so answering a reviewer's "please correct the
# operator name" is a variable change here, not a rebuild — and each review
# round trip restarts their clock.
#
# LEGAL_OPERATOR and LEGAL_JURISDICTION are required before going live — they
# have no honest default. The boot check warns about them; `npm run
# launch:check -w server` treats them as errors.
# ---------------------------------------------------------------------------

# Legal entity or individual operating the service, as it should read on the
# policy pages. Defaults to "TurtleType".
# LEGAL_OPERATOR=

# Where support, privacy and deletion requests are handled. This address goes
# on the legal pages AND the OAuth consent screen. Defaults to the real one,
# help@turtlegames.org — set this only to point somewhere else.
# SUPPORT_EMAIL=

# Governing law for the terms, e.g. "England and Wales" or "California, USA".
# Left unset, the terms show a visible "not configured" notice rather than an
# invented jurisdiction — publishing a plausible-looking fake would be worse.
# LEGAL_JURISDICTION=

# Shown as the policies' "last updated" date. Bump it when you change them.
# LEGAL_LAST_UPDATED=20 August 2026

# ---------------------------------------------------------------------------
# Optional tuning (all have sane defaults; you normally do not need these)
# ---------------------------------------------------------------------------

# How often the in-memory typing buffer is flushed to Google Docs, in ms.
# One flush == one batchUpdate call. 800ms is the spec default.
# FLUSH_INTERVAL_MS=800

# Hard ceiling on batchUpdate calls per minute, per job. The Google Docs API
# caps writes at 60/min/doc, so this must stay below 60. The rate limiter
# delays a flush (letting the buffer grow) rather than dropping anything.
# DOCS_WRITES_PER_MINUTE=55

# --- How the writing is paced (these decide what version history looks like) ---
# Shortest gap between writing bursts, in ms. Google Docs snapshots a document
# roughly every 2 minutes, so anything under that is invisible in history.
# Raise it for a more spread-out, more granular trail.
# MIN_CHUNK_REST_MS=150000

# How much text lands in one burst. Roughly one version-history entry per
# burst, so smaller values give more entries and a longer minimum runtime.
# BURST_MIN_CHARS=55
# BURST_MAX_CHARS=150

# Maximum number of jobs replaying at the same time across the whole process.
# Extra jobs sit in 'pending' until a slot frees up.
# MAX_CONCURRENT_JOBS=20

# Reject job text longer than this many characters.
# MAX_TEXT_LENGTH=200000

# Number of proxies in front of the app. Required for secure cookies behind a
# TLS-terminating proxy. Use 1 for Railway/Render alone, 2 when Cloudflare's
# proxy (the orange cloud) sits in front of them. Accepts true/false as well.
# TRUST_PROXY=1

# ---------------------------------------------------------------------------
# Self-hosting only (docker-compose.yml). Ignored by Railway/Render, which
# provide DATABASE_URL and set the domain themselves.
# ---------------------------------------------------------------------------

# The domain the app is served from. Compose derives GOOGLE_CALLBACK_URL and
# CLIENT_URL from it, and Caddy requests a certificate for it.
# APP_DOMAIN=type.turtlegames.org

# Credentials for the Postgres container.
# POSTGRES_USER=humantype
# POSTGRES_PASSWORD=
# POSTGRES_DB=humantype

# NODE_ENV=development
